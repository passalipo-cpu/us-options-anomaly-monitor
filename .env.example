# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail SMTP: use a Google App Password, never your normal Google password
EMAIL_USERNAME=passalipo@gmail.com
EMAIL_APP_PASSWORD=
EMAIL_TO=passalipo@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Scanner
WATCHLIST=
MAX_EXPIRATIONS=4
MIN_VOLUME=100
ALERT_SCORE=65
REQUEST_DELAY_SECONDS=0.5
MAX_DETAILED_LOG_ALERTS=40
MAX_EMAIL_ALERTS=30
MAX_TELEGRAM_ALERTS=20
DATABASE_PATH=data/options.db
REPORT_DIR=reports
DRY_RUN=1
